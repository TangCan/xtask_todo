{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xtask todo export",
  "type": "object",
  "required": ["version", "todos"],
  "properties": {
    "version": { "const": 1, "description": "Export schema version." },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "completed", "created_at_secs", "tags"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "completed": { "type": "boolean" },
          "created_at_secs": { "type": "integer", "minimum": 0 },
          "completed_at_secs": { "type": ["integer", "null"], "minimum": 0 },
          "description": { "type": ["string", "null"] },
          "due_date": { "type": ["string", "null"] },
          "priority": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "repeat_rule": { "type": ["string", "null"] },
          "repeat_until": { "type": ["string", "null"] },
          "repeat_count": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
